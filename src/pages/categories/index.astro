---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TaxonomyCloud from "@/components/TaxonomyCloud.astro";
import { collectCategories, getPublishedNotes, taxonomySlug } from "@/lib/notes";

const notes = await getPublishedNotes();
const categories = collectCategories(notes).map((category) => ({
  label: category,
  href: `/categories/${taxonomySlug(category)}/`,
  count: notes.filter((note) => note.data.categories.includes(category)).length
}));
---

<BaseLayout title="分类" description="按主题分类浏览笔记。">
  <section class="note-hero">
    <p class="eyebrow">Categories</p>
    <h1>分类</h1>
    <p class="lead">分类适合放稳定的大方向，例如数学、系统、机器学习、文学、研究方法。</p>
  </section>
  <section>
    <div class="section-head">
      <h2>全部分类</h2>
    </div>
    <TaxonomyCloud items={categories} />
  </section>
</BaseLayout>
