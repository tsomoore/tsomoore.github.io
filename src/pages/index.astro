---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NoteList from "@/components/NoteList.astro";
import { NOTE_TYPES, getPublishedNotes } from "@/lib/notes";

const notes = await getPublishedNotes();
const latestNotes = notes.slice(0, 8);
const counts = NOTE_TYPES.map((type) => ({
  type,
  count: notes.filter((note) => note.data.type === type).length
}));
---

<BaseLayout>
  <section class="hero">
    <div>
      <p class="eyebrow">Computing · Reading · Research</p>
      <h1>在算法与文本之间，整理可复用的思想。</h1>
      <p class="lead">
        这里记录读书札记、计算机学习、论文阅读与偶发的随笔。公式、代码、图像和引文并置，用分类保存知识的骨架，用标签保留问题生长的痕迹。
      </p>
    </div>
    <aside class="formula-card" aria-label="博客风格示例">
      <p>技术给问题以形式，人文给形式以语境。</p>
      <p class="math-line">把证明写清楚，把疑问留完整。</p>
    </aside>
  </section>

  <section aria-labelledby="types-title">
    <div class="section-head">
      <h2 id="types-title">笔记类型</h2>
    </div>
    <div class="type-grid">
      {
        counts.map((item) => (
          <a class="type-pill" href="/archive/">
            <strong>{item.type}</strong>
            <small>{item.count} notes</small>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="latest-title">
    <div class="section-head">
      <h2 id="latest-title">最近更新</h2>
      <a href="/archive/">查看全部</a>
    </div>
    <NoteList notes={latestNotes} />
  </section>
</BaseLayout>
